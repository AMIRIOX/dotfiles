{
    "custom/launcher": {
        "format": " <span color='#8aadf4'>\uf313</span>",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "custom/weather": {
        "exec": "python3 ~/.config/waybar/scripts/weather.py",
        "return-type": "json",
        "interval": 300,
        "on-click": "xdg-open https://wttr.in/Harbin"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 12
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "\uebc6",
            "2": "\uf268",
            "3": "\uf249",
            "4": "\uf1bc",
            "5": "\udb82\udcb9",
            "6": "\uf086",
            "urgent": "\uf06a",
            "default": "\uf111"
        },
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },
    "niri/window": {
        "format": "{}",
        "max-length": 60,
        "rewrite": {
            "(.*) - .*Microsoft.*Edge.*": "\uf282 edge",
            "(.*) - YesPlayMusic": "\uf1bc Music",
            "(.*) - Google Chrome": "\uf268 chrome",
            "(.*) — Okular": "\ueebe Okular",
            "org.pwmt.zathura": "\uf1ea zathura",
            "Spotify": "\uf1bc spotify"
        }
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "\udb83\udee0 {usage}%",
        "on-click": "kitty btop",
        "tooltip": true
    },
    "memory": {
        "format": "\udb80\udf5b {used:0.1f}G",
        "format-alt": "\udb80\udf5b {}%"
    },
    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "max-length": 20,
        "format": "{icon} {capacity}%",
        "format-warning": "{icon} {capacity}%",
        "format-critical": "{icon} {capacity}%",
        "format-charging": "\udb80\udc84 {capacity}%",
        "format-plugged": "\udb80\udc79 {capacity}%",
        "format-full": "\udb80\udc79 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["\udb80\udc7a", "\udb80\udc7c", "\udb80\udc7e", "\udb80\udc80", "\udb80\udc82"]
    },
    "custom/gpu-temperature": {
        "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
        "format": "\udb81\udd0f {}°C",
        "return-type": "",
        "interval": 5,
        "on-click": "nvidia-settings"
    },
    "network": {
        "interval": 1,
        "format-wifi": "\udb81\udda9",
        "format-ethernet": "\udb80\ude00",
        "tooltip-format": "\udb81\udda9 {ifname} via {gwaddr}\nconnected to {essid} at {signalStrength}% strength",
        "format-linked": "\udb81\udda8 {ifname} (No IP)",
        "format-disconnected": "",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "bash ~/.config/waybar/scripts/rofi-wifi-menu.sh"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "\udb80\udcaf {icon} {volume}%",
        "format-muted": "\udb81\udd81",
        "format-icons": {
            "headset": "\uf025",
            "headphone": "\udb86\udc4f",
            "phone": "\uf095",
            "car": "\uf1b9",
            "default": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": "\udb80\udcaf {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "~/.config/waybar/scripts/rofi-bluetooth &"
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "custom/gpu-temperature",
            "cpu",
            "memory",
            "battery",
            "pulseaudio",
            "network",
            "bluetooth"
        ]
    }
}
